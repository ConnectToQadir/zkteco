{
  "name": "punchtype",
  "version": "1.0.0",
  "description": "PunchType — ZKTeco attendance punch to keyboard typing utility",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "mac": "PUNCHTYPE_MOCK_DEVICE=1 node src/index.js",
    "mac:dev": "PUNCHTYPE_MOCK_DEVICE=1 node --watch src/index.js",
    "mac:smoke": "node scripts/mac-smoke.js",
    "machine-id": "node scripts/print-machine-id.js",
    "start:background": "node src/index.js --background",
    "license:issue": "node tools/license-generator/issue.js",
    "obfuscate": "node scripts/prepare-obfuscation.js",
    "build": "node scripts/build.js",
    "build:installer": "node scripts/build-installer.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "zkteco",
    "attendance",
    "keyboard",
    "windows"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^5.1.0",
    "javascript-obfuscator": "^4.2.2",
    "koffi": "^2.16.3",
    "node-zklib": "^1.3.0",
    "systeminformation": "^5.33.1",
    "zkteco-js": "^1.7.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "obfuscated/out/src/**/*.js",
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "src/keys/public.pem",
      "obfuscated/out/public/**/*",
      "obfuscated/out/src/keys/public.pem",
      "node_modules/koffi/**/*"
    ],
    "outputPath": "dist"
  }
}
